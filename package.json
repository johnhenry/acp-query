{
  "name": "@johnhenry/acpq",
  "version": "0.1.0-rc.3",
  "description": "Reactive session/turn store + permission broker for the Agent Client Protocol — embeddable ACP client state for web UIs, notebooks, and editors. On the official @agentclientprotocol/sdk.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johnhenry/acp-query.git"
  },
  "homepage": "https://github.com/johnhenry/acp-query",
  "bugs": "https://github.com/johnhenry/acp-query/issues",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/mockAgent.d.ts",
      "default": "./dist/testing/mockAgent.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "example:01": "tsx examples/01-basic-turn.ts",
    "example:02": "tsx examples/02-tool-calls.ts",
    "example:03": "tsx examples/03-permission-inbox.ts",
    "example:04": "tsx examples/04-policy-rules.ts",
    "example:05": "tsx examples/05-multi-session.ts",
    "example:06": "tsx examples/06-cancel.ts",
    "example:07": "tsx examples/07-devtools-timeline.ts",
    "example:08": "tsx examples/08-client-capabilities.ts",
    "example:09": "tsx examples/09-wire-timeline.ts"
  },
  "dependencies": {
    "@johnhenry/agent-query-core": "0.1.0-rc.3"
  },
  "peerDependencies": {
    "@agentclientprotocol/sdk": "1.3.0"
  },
  "devDependencies": {
    "@agentclientprotocol/sdk": "1.3.0",
    "@vitest/coverage-v8": "^4.1.9",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.9"
  }
}
