{
  "name": "@johnhenry/acpq",
  "version": "0.1.0-rc.1",
  "description": "Reactive session/turn store + permission broker for the Agent Client Protocol \u2014 embeddable ACP client state for web UIs, notebooks, and editors. On the official @agentclientprotocol/sdk.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johnhenry/acp-query.git"
  },
  "homepage": "https://github.com/johnhenry/acp-query",
  "bugs": "https://github.com/johnhenry/acp-query/issues",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/mockAgent.d.ts",
      "default": "./dist/testing/mockAgent.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@johnhenry/agent-query-core": "0.1.0-rc.1"
  },
  "peerDependencies": {
    "@agentclientprotocol/sdk": "1.3.0"
  },
  "devDependencies": {
    "@agentclientprotocol/sdk": "1.3.0",
    "@vitest/coverage-v8": "^4.1.9",
    "typescript": "^5.9.3",
    "vitest": "^4.1.9"
  }
}
